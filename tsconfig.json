{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		// NOT incremental. `n8n-node build` deletes dist/ and then runs tsc, so a
		// surviving .tsbuildinfo makes tsc skip every file it considers unchanged
		// and the build silently emits a partial dist/ (a package missing
		// transport.js loads as a broken node in n8n). The full build takes a few
		// seconds; correctness is worth more.
		"declaration": true,
		"sourceMap": false,
		"skipLibCheck": true,
		"outDir": "./dist/"
	},
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json"]
}
